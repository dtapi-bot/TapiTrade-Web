{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tapi-trade-web.vercel.app"
        }
      ],
      "destination": "https://www.tapitrade.com/:path*",
      "permanent": true
    },
    {
      "source": "/workshop",
      "destination": "/workshop/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/workshop/:path*",
      "destination": "https://landing-page-workshop-nine.vercel.app/:path*"
    }
  ]
}
